#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Pre-commit gate for terraform-provider-penguin — runs the full check
# (go mod tidy + gofmt + go vet + go build + go test). Enable once per clone:
#     git config core.hooksPath .githooks
# Never bypass with --no-verify; if the hook is wrong, fix the hook.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
exec make check
